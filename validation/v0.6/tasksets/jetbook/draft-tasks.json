        "src/lib/auth/throttle.ts"
      ],
      "expectedMatch": "all",
      "expectedSemanticEdges": [
        {
          "from": "src/lib/auth/throttle.ts#recordLoginFailure",
          "relation": "CALLS",
          "to": "src/lib/auth/throttle.ts#lockDurationMs"
        }
