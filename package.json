{
  "name": "stellarcode",
  "version": "0.5.2",
  "description": "A living map of your codebase for humans and AI agents.",
  "type": "module",
  "bin": {
    "stellar": "./bin/stellar.js"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec tests/*.test.js",
    "demo:init": "node src/cli.js init fixtures/sample",
    "demo:scan": "node src/cli.js scan fixtures/sample",
    "demo:serve": "node src/cli.js ui --port 7432",
    "benchmark:report": "node src/cli.js benchmark report benchmark/baseline.example.jsonl benchmark/stellar.example.jsonl",
    "benchmark:doctor": "node src/cli.js benchmark doctor --json"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT",
  "keywords": [
    "codebase",
    "graph",
    "mcp",
    "ai",
    "repository",
    "developer-tools"
  ]
}
